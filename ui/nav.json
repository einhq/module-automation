{
  "sidebar": [
    {
      "id": "automation.automations",
      "section": "system",
      "label": "Automations",
      "icon": "topology-star-3",
      "to": "/automations",
      "order": 25,
      "group": "automation"
    }
  ],
  "panels": [
    {
      "id": "automation.live",
      "slot": "device.tabs",
      "label": "Live",
      "icon": "video",
      "route": "/camera-live?device={path}",
      "when": {
        "has": "stream"
      }
    },
    {
      "id": "automation.found-devices",
      "slot": "devices.header",
      "label": "Found on the network",
      "icon": "radar",
      "route": "/found-devices-button",
      "signedIn": true
    },
    {
      "id": "automation.mqtt",
      "slot": "settings.views",
      "label": "MQTT broker",
      "description": "The broker the automation bridge hears devices on, and the account it signs in with.",
      "icon": "topology-star-3",
      "route": "/settings/mqtt",
      "admin": true,
      "order": 30
    },
    {
      "id": "automation.restreamer",
      "slot": "settings.views",
      "label": "Restreamer",
      "description": "Where cameras' live views and pictures come from, and where the media service reads their streams.",
      "icon": "video",
      "route": "/settings/restreamer",
      "admin": true,
      "order": 35
    }
  ]
}
