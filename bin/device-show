#!ts
/**
 * device-show — a device and each of its entities with its latest value.
 */

import type { CmdReturn, Command } from '@ein/client';
import { collectUnknownFlags, parseArgs, reportUnknownFlags } from '@ein/client';
import type { DeviceInfo } from '@automation/api';
import { parseTarget } from '@automation/paths';
import { deviceInfo, fail, valueText } from '@automation/store';

const deviceShow = async (cmd: Command): CmdReturn => {
  const unknown: string[] = [];
  const flags = parseArgs(cmd.args, { unknown: collectUnknownFlags(unknown) });
  if (await reportUnknownFlags(cmd, unknown)) return 1;
  const target = parseTarget(String(flags._[0] ?? ''));
  if (!target || target.entity) return await fail(cmd, 'device-show', 'usage: device-show <device>');
  try {
    const info = await deviceInfo(cmd, target.device);
    if (cmd.json) {
      await cmd.writeJSON(info satisfies DeviceInfo);
      return 0;
    }
    const about = [info.manufacturer, info.model, info.sw].filter(Boolean).join(' ');
    await cmd.writeLn(`${info.label} (${info.name})${about ? `  ${about}` : ''}${info.online === false ? '  offline' : ''}`);
    for (const entity of info.entityList) {
      const value = entity.last ? `${valueText(entity.last.value)}${entity.unit ? ` ${entity.unit}` : ''}  ${entity.last.at}` : '-';
      const notes = [entity.settable ? 'settable' : '', entity.supported ? '' : 'not read', entity.retired ? 'retired' : ''].filter(Boolean).join(', ');
      await cmd.writeLn(`  ${entity.name}  ${entity.kind}  ${value}${notes ? `  (${notes})` : ''}`);
    }
    return 0;
  } catch (error) {
    return await fail(cmd, 'device-show', error);
  }
};

deviceShow.spec = {
  name: 'device-show',
  effect: 'read' as const,
  description: 'Show a device and each of its entities (readings, switches, buttons) with its latest value and whether it can be set',
  args: [{ name: 'device', type: 'string' as const, description: 'the device, by its name or path' }],
  examples: ['device-show hall-plug'],
  returns: 'DeviceInfo: the DeviceSummary fields, sw, mac and entityList (EntitySummary[]: name, path, label, kind, unit, supported, retired, settable, last {value, at})',
};

export default deviceShow;
