#!ts
/**
 * automation-status — whether the bridge hears the broker, which drivers it registered, how many
 * devices they drive, and the automations; whether the restreamer answers; or what each node of one
 * automation last did.
 *
 *   automation-status                 everything, as JSON in JSON mode
 *   automation-status --brief         one line, for the services list
 *   automation-status --checks        the checks `health` reads
 *   automation-status --automations   one line on the automation engine
 *   automation-status --streams       whether the restreamer answers, as JSON in JSON mode
 *   automation-status hall-light      each node of a running automation: what it last sent, when, what it waits for
 */

import type { DeviceAttrs } from '@ein/api';
import type { CmdReturn, Command, HealthCheck } from '@ein/client';
import { collectUnknownFlags, parseArgs, reportUnknownFlags, serviceKey } from '@ein/client';
import { DEV_PATH, devicePath } from '@ein/paths';
import type { AutomationRunStatus, AutomationStatus, RestreamerStatus } from '@automation/api';
import { createRestreamer } from '@automation/cameras';
import { mayChange, readAs, resolveAutomation } from '@automation/automation-commands';
import { POLLED_DRIVERS } from '@automation/network';
import { SOURCE_NAMES } from '@automation/sources';
import { bridgeState, engineState } from '@automation/state';

const ENDPOINT_TYPES = new Set(['log', 'track', 'control']);

/** The devices under /dev the caller sees that automation's drivers drive, and their endpoints. */
const counts = async (cmd: Command): Promise<{ devices: number; endpoints: number }> => {
  const children = await cmd.sys.vfs.children<DeviceAttrs>(cmd.access, DEV_PATH).catch(() => []);
  const ours = children.filter((child) => child.node.type === 'device' && [...SOURCE_NAMES, ...POLLED_DRIVERS].includes(child.node.attrs.driver ?? ''));
  const endpoints = await Promise.all(
    ours.map(async (child) => (await cmd.sys.vfs.children(cmd.access, devicePath(child.name)).catch(() => [])).filter((each) => ENDPOINT_TYPES.has(each.node.type)).length),
  );
  return { devices: ours.length, endpoints: endpoints.reduce((sum, each) => sum + each, 0) };
};

const statusOf = async (cmd: Command): Promise<AutomationStatus> => {
  const url = (cmd.env.CFG_AUTOMATION_MQTT_URL ?? '').trim();
  const state = bridgeState();
  const engine = engineState();
  return {
    configured: url !== '',
    ...(url ? { url } : {}),
    running: state !== undefined,
    connected: state?.connected ?? false,
    ...(state ? { since: new Date(state.since).toISOString() } : {}),
    drivers: state?.drivers ?? [],
    ...await counts(cmd),
    messages: state?.messages ?? 0,
    unsupported: state?.notes() ?? [],
    ...(state?.lastError ? { lastError: state.lastError } : {}),
    ...(engine ? { automations: automationsOf(engine) } : {}),
  };
};

const automationsOf = (engine: NonNullable<ReturnType<typeof engineState>>): NonNullable<AutomationStatus['automations']> => {
  const known = [...engine.known()];
  return {
    running: known.filter(([, each]) => each.running).length,
    actions: engine.actions,
    problems: known.filter(([, each]) => each.problems.length).map(([name, each]) => `${name}: ${each.problems[0].message}`),
  };
};

/** One automation's nodes, for whoever may change it: what its nodes say is its owner's to see. */
const runStatus = async (cmd: Command, arg: string): Promise<AutomationRunStatus> => {
  const file = await readAs(cmd, resolveAutomation(arg).path);
  if (!(await mayChange(cmd, file))) throw new Error(`what ${file.name}'s nodes say is for those who may change it`);
  const known = engineState()?.known().get(file.name);
  return {
    name: file.name,
    running: known?.running ?? false,
    problems: file.problems.length ? file.problems : known?.problems ?? [],
    nodes: engineState()?.status(file.name) ?? {},
  };
};

/** The restreamer, asked for its streams as the bridge signs in to it. */
const restreamerOf = async (cmd: Command): Promise<RestreamerStatus> => {
  const url = (cmd.env.CFG_AUTOMATION_STREAMS_URL ?? '').trim();
  if (!url) return { configured: false, answering: false };
  const rtsp = (cmd.env.CFG_AUTOMATION_STREAMS_RTSP ?? '').trim();
  const said = { configured: true, url, ...(rtsp ? { rtsp } : {}) };
  try {
    const restreamer = createRestreamer(fetch, url, await serviceKey(cmd, 'CFG_AUTOMATION_STREAMS_KEY', 'CFG_AUTOMATION_STREAMS_URL') ?? '', rtsp);
    return { ...said, answering: true, streams: (await restreamer.names()).size };
  } catch (error) {
    return { ...said, answering: false, error: error instanceof Error ? error.message : String(error) };
  }
};

const brief = (status: AutomationStatus): string => {
  if (!status.running) return 'not running';
  if (!status.configured) return `${status.devices} devices, ${status.endpoints} endpoints; no broker set, so only the devices asked over the network are read`;
  if (!status.connected) return `cannot reach ${status.url}${status.lastError ? `: ${status.lastError}` : ''}`;
  return `${status.devices} devices, ${status.endpoints} endpoints, ${status.messages} messages`;
};

const checks = (status: AutomationStatus): HealthCheck[] => {
  if (!status.running) return [{ name: 'automation bridge', state: 'fail', reason: 'the automation-bridge service is not running' }];
  if (!status.configured) return [{ name: 'automation bridge', state: 'ok', reason: brief(status) }];
  if (!status.connected) {
    return [{ name: 'automation bridge', state: 'warn', reason: `cannot reach the broker at ${status.url}${status.lastError ? `: ${status.lastError}` : ''}` }];
  }
  return [{ name: 'automation bridge', state: 'ok', reason: brief(status) }];
};

const automationStatus = async (cmd: Command): CmdReturn => {
  const unknown: string[] = [];
  const flags = parseArgs(cmd.args, { boolean: ['brief', 'checks', 'automations', 'streams'], unknown: collectUnknownFlags(unknown) });
  if (await reportUnknownFlags(cmd, unknown)) return 1;
  if (flags.streams) {
    const streams = await restreamerOf(cmd);
    if (cmd.json) await cmd.writeJSON(streams satisfies RestreamerStatus);
    else if (!streams.configured) await cmd.writeLn('no restreamer is set');
    else await cmd.writeLn(streams.answering ? `${streams.url}: ${streams.streams} streams` : `${streams.url}: ${streams.error}`);
    return 0;
  }
  if (flags._.length) {
    try {
      const run = await runStatus(cmd, String(flags._[0]));
      if (cmd.json) await cmd.writeJSON(run satisfies AutomationRunStatus);
      else {
        await cmd.writeLn(`${run.name}: ${run.running ? 'running' : 'not running'}`);
        for (const problem of run.problems) await cmd.writeLn(`  ${problem.node ? `${problem.node}: ` : ''}${problem.message}`);
        for (const [id, node] of Object.entries(run.nodes)) {
          const said = node.value !== undefined ? ` sent ${JSON.stringify(node.value)}${node.at ? ` at ${node.at}` : ''}` : '';
          await cmd.writeLn(`  ${id}:${said}${node.due ? `, next at ${node.due}` : ''}${node.problem ? `; ${node.problem}` : ''}`);
        }
      }
      return 0;
    } catch (error) {
      await cmd.writeError(`automation-status: ${error instanceof Error ? error.message : error}\n`);
      return 1;
    }
  }
  const status = await statusOf(cmd);
  if (flags.automations) {
    const automations = status.automations;
    await cmd.writeLn(
      automations
        ? `${automations.running} running, ${automations.actions} actions${automations.problems.length ? `, ${automations.problems.length} not run` : ''}`
        : 'not running',
    );
  } else if (flags.checks) {
    await cmd.writeJSON(checks(status) satisfies HealthCheck[]);
  } else if (flags.brief || !cmd.json) {
    await cmd.writeLn(brief(status));
    if (!flags.brief) {
      if (status.drivers.length) await cmd.writeLn(`drivers: ${status.drivers.join(', ')}`);
      for (const note of status.unsupported) await cmd.writeLn(`  not read: ${note}`);
      if (status.automations) await cmd.writeLn(`automations: ${status.automations.running} running, ${status.automations.actions} actions`);
      for (const problem of status.automations?.problems ?? []) await cmd.writeLn(`  not run: ${problem}`);
    }
  } else {
    await cmd.writeJSON(status satisfies AutomationStatus);
  }
  return 0;
};

automationStatus.spec = {
  name: 'automation-status',
  effect: 'read' as const,
  description:
    'Whether the automation bridge hears the MQTT broker, which drivers it registered, how many devices under /dev they drive, what they cannot read, and the automations; or, given one, what each of its nodes last did',
  flags: [
    { name: 'brief', type: 'bool' as const, description: 'one line, as the services list shows it' },
    { name: 'checks', type: 'bool' as const, description: 'the checks health reads, as JSON' },
    { name: 'automations', type: 'bool' as const, description: 'one line on the automation engine, as the services list shows it' },
    { name: 'streams', type: 'bool' as const, description: 'whether the restreamer answers, and how many streams it has' },
  ],
  args: [{ name: 'automation', type: 'string' as const, description: 'one automation, whose nodes to show', optional: true }],
  examples: ['automation-status', 'automation-status --brief', 'automation-status --streams', 'automation-status hall-light'],
  returns:
    'AutomationStatus: configured, url, running, connected, since, drivers, devices, endpoints, messages, unsupported, lastError, automations {running, actions, problems}; with an automation, AutomationRunStatus: name, running, problems, nodes; with --streams, RestreamerStatus: configured, url, rtsp, answering, streams, error',
};

export default automationStatus;
