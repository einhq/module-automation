#!ts
/**
 * automation-bridge — the automation-bridge service: hears devices on the MQTT broker and drives
 * them as core's devices under /dev, one driver per source (ha-discovery, shelly), sending them what
 * is written to their controls.
 *
 * Off while CFG_AUTOMATION_MQTT_URL is empty: it says so and ends. Otherwise it runs until stopped,
 * connecting again whenever the broker goes away.
 */

import { type CmdReturn, type Command, serviceKey } from '@ein/client';
import { runBridge } from '@automation/bridge';
import { DeviceWriter } from '@automation/drivers';
import { connectMqtt } from '@automation/mqtt';
import { createSources } from '@automation/sources';
import { bridgeState } from '@automation/state';

const DEFAULT_SOURCES = 'ha-discovery shelly shelly-gen1';
const DEFAULT_MIN_INTERVAL_SECONDS = 10;

const automationBridge = async (cmd: Command): CmdReturn => {
  const url = (cmd.env.CFG_AUTOMATION_MQTT_URL ?? '').trim();
  if (!url) {
    await cmd.writeLn('automation-bridge: off, CFG_AUTOMATION_MQTT_URL is empty: no device is heard');
    return 0;
  }
  const devices = cmd.sys.devices;
  if (!devices) {
    await cmd.writeError('automation-bridge: this EiN keeps no devices, so there is nothing to drive\n');
    return 1;
  }
  if (bridgeState()) {
    await cmd.writeError('automation-bridge: already running\n');
    return 1;
  }
  const stopped = new Promise<void>((resolve) => cmd.onInterrupt(resolve));

  const clientId = `ein-automation-${crypto.randomUUID().slice(0, 8)}`;
  const names = (cmd.env.CFG_AUTOMATION_SOURCES || DEFAULT_SOURCES).split(/[\s,]+/).filter(Boolean);
  const { sources, unknown } = createSources(names, {
    discoveryPrefix: cmd.env.CFG_AUTOMATION_DISCOVERY_PREFIX || 'homeassistant',
    clientId,
  });
  if (unknown.length) await cmd.writeError(`automation-bridge: no source called ${unknown.join(', ')}\n`);
  const seconds = Number(cmd.env.CFG_AUTOMATION_MIN_INTERVAL);
  const writer = new DeviceWriter({
    cmd,
    devices,
    retention: cmd.env.CFG_AUTOMATION_HISTORY || '365 day',
    minInterval: Number.isFinite(seconds) && seconds >= 0 ? seconds : DEFAULT_MIN_INTERVAL_SECONDS,
    log: (line) => cmd.writeError(`automation-bridge: ${line}\n`).catch(() => {}),
  });
  const password = await serviceKey(cmd, 'CFG_AUTOMATION_MQTT_KEY', 'CFG_AUTOMATION_MQTT_URL');
  const connect = connectMqtt({ url, clientId, username: cmd.env.CFG_AUTOMATION_MQTT_USER, password });
  await runBridge({ cmd, url, connect, sources, devices, writer, stopped });
  return 0;
};

automationBridge.spec = {
  name: 'automation-bridge',
  admin: true,
  daemon: true,
  effect: 'write' as const,
  json: false,
  description:
    'Hear devices on the MQTT broker and drive them as devices under /dev (the ha-discovery and shelly drivers), sending them what is written to their controls (the automation-bridge service)',
  examples: ['service restart automation-bridge'],
};

export default automationBridge;
