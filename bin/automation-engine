#!ts
/**
 * automation-engine — the automation-engine service: runs every automation that is on, each as its
 * owner, when a reading, a press, a device coming or going or the clock says so.
 */

import type { CmdReturn, Command } from '@ein/client';
import { runAutomationService } from '@automation/automation-service';
import { gidOf } from '@automation/groups';
import { AUTOMATION_GROUP } from '@automation/paths';
import { engineState } from '@automation/state';

const automationEngine = async (cmd: Command): CmdReturn => {
  if (engineState()) {
    await cmd.writeError('automation-engine: already running\n');
    return 1;
  }
  const stopped = new Promise<void>((resolve) => cmd.onInterrupt(resolve));
  await runAutomationService({ cmd, stopped, automationGid: await gidOf(cmd, AUTOMATION_GROUP) });
  return 0;
};

automationEngine.spec = {
  name: 'automation-engine',
  admin: true,
  daemon: true,
  effect: 'write' as const,
  json: false,
  description:
    'Run the automations under /etc/automations and /etc/automations.d when a reading, a press, a device coming or going or the clock says so, each as its owner (the automation-engine service)',
  examples: ['service restart automation-engine'],
};

export default automationEngine;
