#!ts
/**
 * automation-rule-check — a rule file as the rules service reads it: what makes it run, whether its
 * conditions hold now, and whose rights its lines run with; or why it is not run. With --run its
 * lines run now, as the caller, until one fails.
 */

import type { CmdReturn, Command } from '@ein/client';
import { collectUnknownFlags, parseArgs, reportUnknownFlags } from '@ein/client';
import type { RuleCheck } from '@automation/api';
import { RULES_DIR } from '@automation/paths';
import { latestValues, onlineDevices, readRuleFile } from '@automation/rule-files';
import { conditionText, meets, triggerText } from '@automation/rules';

/** A command's failure, said once on stderr. */
const fail = async (cmd: Command, error: unknown): Promise<number> => {
  await cmd.writeError(`automation-rule-check: ${error instanceof Error ? error.message : error}\n`);
  return 1;
};

/** The account with `uid`, by name when there is one. */
const nameOf = async (cmd: Command, uid: number): Promise<string> => {
  const { stdout } = await cmd.execute(`JSON_OUTPUT=1 user-list`).catch(() => ({ stdout: '[]' }));
  try {
    const users = JSON.parse(stdout) as { username?: string; uid?: number }[];
    return users.find((each) => each.uid === uid)?.username ?? String(uid);
  } catch {
    return String(uid);
  }
};

const automationRuleCheck = async (cmd: Command): CmdReturn => {
  const unknown: string[] = [];
  const flags = parseArgs(cmd.args, { boolean: ['run'], unknown: collectUnknownFlags(unknown) });
  if (await reportUnknownFlags(cmd, unknown)) return 1;
  const target = flags._[0] === undefined ? '' : String(flags._[0]);
  if (!target) return await fail(cmd, 'usage: automation-rule-check <rule or file> [--run]');
  const path = target.includes('/') ? (target.startsWith('/') ? target : `${cmd.cwd}/${target}`) : `${RULES_DIR}/${target.replace(/\.yaml$/, '')}.yaml`;
  try {
    const file = await readRuleFile(cmd, path);
    const check: RuleCheck = { name: file.name, path: file.path, owner: await nameOf(cmd, file.owner), ...(file.problem ? { problem: file.problem } : {}) };
    const rule = file.rule;
    if (rule) {
      const values = await latestValues(cmd, [rule]);
      const online = await onlineDevices(cmd);
      check.description = rule.description;
      check.when = rule.when.map(triggerText);
      check.if = rule.if.map((condition) => ({ condition: conditionText(condition), holds: meets(condition, values, online) }));
      check.then = rule.then;
    }
    if (flags.run && rule) {
      check.ran = [];
      for (const line of rule.then) {
        const result = await cmd.execute(line);
        if (!cmd.json) {
          if (result.stdout) await cmd.write(result.stdout);
          if (result.stderr) await cmd.writeError(result.stderr);
        }
        check.ran.push({ line, code: result.code });
        if (result.code !== 0) break;
      }
    }
    if (cmd.json) {
      await cmd.writeJSON(check satisfies RuleCheck);
    } else if (!flags.run) {
      await cmd.writeLn(`${check.name} (${check.path}), runs as ${check.owner}`);
      if (check.problem) await cmd.writeLn(`  not run: ${check.problem}`);
      if (check.description) await cmd.writeLn(`  ${check.description}`);
      for (const when of check.when ?? []) await cmd.writeLn(`  when ${when}`);
      for (const each of check.if ?? []) await cmd.writeLn(`  if ${each.condition}: ${each.holds ? 'holds now' : 'does not hold now'}`);
      for (const line of check.then ?? []) await cmd.writeLn(`  then ${line}`);
    }
    if (file.problem) return 1;
    return check.ran?.some((each) => each.code !== 0) ? 1 : 0;
  } catch (error) {
    return await fail(cmd, error);
  }
};

automationRuleCheck.spec = {
  name: 'automation-rule-check',
  effect: 'read' as const,
  description:
    'Check an automation rule: what makes it run, whether its conditions hold now and whose rights its lines run with, or why it is not run; with --run, run its lines now',
  args: [{ name: 'rule', type: 'string' as const, description: 'the rule by name (a file in /etc/automation/rules), or a path to a rule file' }],
  flags: [{ name: 'run', type: 'bool' as const, description: 'run its lines now, as you, until one fails', writes: true }],
  examples: ['automation-rule-check hall-light', 'automation-rule-check ~/draft.yaml', 'automation-rule-check hall-light --run'],
  returns: 'RuleCheck: name, path, owner, problem, description, when, if [{condition, holds}], then, ran [{line, code}]',
};

export default automationRuleCheck;
