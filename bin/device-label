#!ts
/**
 * device-label — what a device or one of its entities is called on its page. The node keeps its
 * name, so nothing bound to its routing keys changes. For members of the automation group.
 */

import type { CmdReturn, Command } from '@ein/client';
import { collectUnknownFlags, parseArgs, reportUnknownFlags } from '@ein/client';
import { devicePath, entityPath, parseTarget } from '@automation/paths';
import { fail } from '@automation/store';

const deviceLabel = async (cmd: Command): CmdReturn => {
  const unknown: string[] = [];
  const flags = parseArgs(cmd.args, { unknown: collectUnknownFlags(unknown) });
  if (await reportUnknownFlags(cmd, unknown)) return 1;
  const target = parseTarget(String(flags._[0] ?? ''));
  const label = flags._.slice(1).map(String).join(' ').trim();
  if (!target || !label) return await fail(cmd, 'device-label', 'usage: device-label <device>[/<entity>] <label>');
  const path = target.entity ? entityPath(target.device, target.entity) : devicePath(target.device);
  try {
    await cmd.sys.vfs.update(cmd.access, path, { attrs: { label } });
    if (cmd.json) await cmd.writeJSON({ ok: true });
    return 0;
  } catch (error) {
    return await fail(cmd, 'device-label', error);
  }
};

deviceLabel.spec = {
  name: 'device-label',
  effect: 'write' as const,
  description: 'Name a device or one of its entities, as its page shows it; its node name and routing keys stay',
  args: [
    { name: 'target', type: 'string' as const, description: 'the device, or <device>/<entity>' },
    { name: 'label', type: 'string' as const, description: 'what to call it' },
  ],
  examples: ["device-label hall-plug 'Hall lamp'", "device-label hall-sensor/temperature 'Hall temperature'"],
};

export default deviceLabel;
