#!ts
/**
 * device-create — a device made by hand rather than found by a source: a GPS logger whose GPX
 * files are imported, or a boat a phone will post the position of (`--position`, then
 * `device-tracker`). For members of the automation group.
 */

import type { CmdReturn, Command } from '@ein/client';
import { collectUnknownFlags, parseArgs, reportUnknownFlags } from '@ein/client';
import type { DeviceAttrs, DeviceCreated } from '@automation/api';
import { DEVICE_TYPE, devicePath, DEVICES_ROOT } from '@automation/paths';
import { ensurePosition } from '@automation/position';
import { slug } from '@automation/slug';
import { fail } from '@automation/store';

const deviceCreate = async (cmd: Command): CmdReturn => {
  const unknown: string[] = [];
  const flags = parseArgs(cmd.args, { boolean: ['position'], string: ['label', 'model', 'manufacturer'], unknown: collectUnknownFlags(unknown) });
  if (await reportUnknownFlags(cmd, unknown)) return 1;
  const typed = flags._.map(String).join(' ').trim();
  const device = slug(typed);
  if (!device) return await fail(cmd, 'device-create', 'usage: device-create <name> [--label <text>] [--position]');
  try {
    if (await cmd.sys.vfs.exists(cmd.access, devicePath(device))) throw new Error(`${device} exists already`);
    const attrs: DeviceAttrs = {
      label: flags.label || typed,
      source: 'manual',
      ...(flags.manufacturer ? { manufacturer: flags.manufacturer } : {}),
      ...(flags.model ? { model: flags.model } : {}),
    };
    await cmd.sys.vfs.create(cmd.access, DEVICE_TYPE, DEVICES_ROOT, device, { attrs, props: { mode: 0o775 } });
    const track = flags.position ? await ensurePosition(cmd, device) : undefined;
    const created: DeviceCreated = { device, path: devicePath(device), ...(track ? { track } : {}) };
    if (cmd.json) await cmd.writeJSON(created satisfies DeviceCreated);
    else await cmd.writeLn(track ?? created.path);
    return 0;
  } catch (error) {
    return await fail(cmd, 'device-create', error);
  }
};

deviceCreate.spec = {
  name: 'device-create',
  effect: 'write' as const,
  description: 'Make a device by hand, which no source announces: a GPS logger whose files are imported, or something a phone will post the position of (--position)',
  args: [{ name: 'name', type: 'string' as const, description: 'what to call it; its node name is made from it' }],
  flags: [
    { name: 'label', type: 'string' as const, description: 'what its page calls it, when not the name' },
    { name: 'manufacturer', type: 'string' as const, description: 'who made it' },
    { name: 'model', type: 'string' as const, description: 'its model' },
    { name: 'position', type: 'bool' as const, description: 'give it a position, kept as a track, for a tracker or GPX files' },
  ],
  examples: ['device-create Sailboat --position', "device-create 'Old logger' --model 'eTrex 30' --position"],
  returns: 'DeviceCreated: device, path, track',
};

export default deviceCreate;
