#!ts
/**
 * device-forget — remove a device and its history, and tell the broker to stop replaying its
 * announcements. A device that is still on and announces itself again comes back, without its old
 * history. For members of the automation group.
 */

import type { CmdReturn, Command } from '@ein/client';
import { collectUnknownFlags, parseArgs, reportUnknownFlags } from '@ein/client';
import { DEVICE_TYPE, devicePath, DEVICES_ROOT, parseTarget } from '@automation/paths';
import { bridgeState } from '@automation/state';
import { fail } from '@automation/store';

const deviceForget = async (cmd: Command): CmdReturn => {
  const unknown: string[] = [];
  const flags = parseArgs(cmd.args, { unknown: collectUnknownFlags(unknown) });
  if (await reportUnknownFlags(cmd, unknown)) return 1;
  const target = parseTarget(String(flags._[0] ?? ''));
  if (!target || target.entity) return await fail(cmd, 'device-forget', 'usage: device-forget <device>');
  try {
    const node = await cmd.sys.vfs.get(cmd.access, devicePath(target.device));
    if (node.type !== DEVICE_TYPE) throw new Error(`${target.device} is not a device`);
    await cmd.sys.vfs.unlink(cmd.access, devicePath(target.device), DEVICES_ROOT, { recursive: true });
    await bridgeState()?.forget(target.device);
    if (cmd.json) await cmd.writeJSON({ ok: true });
    return 0;
  } catch (error) {
    return await fail(cmd, 'device-forget', error);
  }
};

deviceForget.spec = {
  name: 'device-forget',
  effect: 'write' as const,
  description: 'Remove a device and its history, and stop the broker replaying its announcements; one that is still on comes back when it announces itself',
  args: [{ name: 'device', type: 'string' as const, description: 'the device, by its name or path' }],
  examples: ['device-forget old-sensor'],
};

export default deviceForget;
