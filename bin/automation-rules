#!ts
/**
 * automation-rules — the automation-rules service: runs the rules under /etc/automation/rules when
 * a reading, a press, a device coming or going or the clock says so, each as its file's owner.
 */

import type { CmdReturn, Command } from '@ein/client';
import { gidOf } from '@automation/groups';
import { AUTOMATION_GROUP } from '@automation/paths';
import { runRulesService } from '@automation/rules-service';
import { rulesState } from '@automation/state';

const automationRules = async (cmd: Command): CmdReturn => {
  if (rulesState()) {
    await cmd.writeError('automation-rules: already running\n');
    return 1;
  }
  const stopped = new Promise<void>((resolve) => cmd.onInterrupt(resolve));
  await runRulesService({ cmd, stopped, automationGid: await gidOf(cmd, AUTOMATION_GROUP) });
  return 0;
};

automationRules.spec = {
  name: 'automation-rules',
  admin: true,
  daemon: true,
  effect: 'write' as const,
  json: false,
  description:
    "Run the rules under /etc/automation/rules when a reading, a press, a device coming or going or the clock says so, each as its file's owner (the automation-rules service)",
  examples: ['service restart automation-rules'],
};

export default automationRules;
