#!ts
/**
 * device-tracker — live tracking from a phone or GPS tracker: the link a device's position is
 * posted to, and the QR code that sets Traccar Client up with it.
 *
 *   device-tracker <device> [--origin <url>]          whether it is on, and the link
 *   device-tracker <device> --new [--origin <url>]    turn it on, or replace the link
 *   device-tracker <device> --off                     turn it off
 *
 * `--new` gives the device a position when it has none. The link is core's `track-token` on the
 * position's track; `--origin` is the address the phone reaches EiN at, which only the asker knows,
 * and with it the answer carries the full URL and the QR code. The QR code is the URL with
 * `?id=<device>`, which Traccar Client reads as the server URL and the device identifier.
 */

import type { TrackToken } from '@ein/api';
import type { CmdReturn, Command } from '@ein/client';
import { collectUnknownFlags, parseArgs, reportUnknownFlags, shq } from '@ein/client';
import type { DeviceTracker } from '@automation/api';
import { devicePath, parseTarget, positionTrackPath } from '@automation/paths';
import { ensurePosition } from '@automation/position';
import { qrSvg } from '@automation/qr';
import { fail } from '@automation/store';

const USAGE = 'usage: device-tracker <device> [--new|--off] [--origin <url>]';

const deviceTracker = async (cmd: Command): CmdReturn => {
  const unknown: string[] = [];
  const flags = parseArgs(cmd.args, { boolean: ['new', 'off'], string: ['origin'], unknown: collectUnknownFlags(unknown) });
  if (await reportUnknownFlags(cmd, unknown)) return 1;
  const target = parseTarget(String(flags._[0] ?? ''));
  if (!target || target.entity) return await fail(cmd, 'device-tracker', USAGE);
  if (flags.new && flags.off) return await fail(cmd, 'device-tracker', '--new and --off do not go together');
  let origin: string | undefined;
  if (flags.origin) {
    try {
      origin = new URL(flags.origin).origin;
    } catch {
      return await fail(cmd, 'device-tracker', `--origin takes a URL such as https://ein.example, not '${flags.origin}'`);
    }
  }
  const { device } = target;
  try {
    if (!(await cmd.sys.vfs.exists(cmd.access, devicePath(device)))) throw new Error(`no device ${device}`);
    const track = flags.new ? await ensurePosition(cmd, device) : positionTrackPath(device);
    let token: TrackToken = { track, enabled: false };
    if (await cmd.sys.vfs.exists(cmd.access, track)) {
      const ran = await cmd.execute(`JSON_OUTPUT=1 track-token ${shq(track)}${flags.new ? ' --new' : flags.off ? ' --off' : ''}`);
      if (ran.code !== 0) throw new Error(ran.stderr.trim().replace(/^track-token: /, '') || 'track-token failed');
      token = JSON.parse(ran.stdout) as TrackToken;
    }
    const answer: DeviceTracker = { device, track, enabled: token.enabled };
    if (token.path) {
      answer.url = origin ? `${origin}${token.path}` : token.path;
      if (origin) {
        answer.qrText = `${answer.url}?id=${encodeURIComponent(device)}`;
        answer.qrSvg = qrSvg(answer.qrText);
      }
    }
    if (cmd.json) await cmd.writeJSON(answer satisfies DeviceTracker);
    else await cmd.writeLn(answer.url ?? `${device} takes no tracker posts`);
    return 0;
  } catch (error) {
    return await fail(cmd, 'device-tracker', error);
  }
};

deviceTracker.spec = {
  name: 'device-tracker',
  effect: 'read' as const,
  description: "Show, turn on, replace or turn off the link a phone or GPS tracker posts a device's position to, with the QR code that sets Traccar Client up",
  args: [{ name: 'device', type: 'string' as const, description: 'the device, by its name or path' }],
  flags: [
    { name: 'new', writes: true, type: 'bool' as const, description: 'turn live tracking on, or replace the link; the one before it stops working' },
    { name: 'off', writes: true, type: 'bool' as const, description: 'turn live tracking off' },
    { name: 'origin', type: 'string' as const, description: 'the address the phone reaches EiN at, such as https://ein.example; adds the full URL and the QR code' },
  ],
  examples: ['device-tracker sailboat', 'device-tracker sailboat --new --origin https://ein.example'],
  returns: 'DeviceTracker: whether live tracking is on, the link, and the QR code',
};

export default deviceTracker;
