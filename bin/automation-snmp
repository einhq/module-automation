#!ts
/**
 * automation-snmp — every object a device's SNMP agent answers under an OID: what an snmp device
 * could say, and what a driver for it would read. For members of the devices group.
 *
 *   automation-snmp 192.0.2.40                     the system group (1.3.6.1.2.1.1)
 *   automation-snmp 192.0.2.40 1.3.6.1.4.1         every vendor's objects
 *   automation-snmp 192.0.2.40 --community home    with another community than CFG_AUTOMATION_SNMP_COMMUNITY
 */

import { type CmdReturn, collectUnknownFlags, type Command, parseArgs, reportUnknownFlags } from '@ein/client';
import type { SnmpObject } from '@automation/api';
import { assertDevicesMember, DEFAULT_COMMUNITY, snmpWalk } from '@automation/network';

const SYSTEM = '1.3.6.1.2.1.1';

const automationSnmp = async (cmd: Command): CmdReturn => {
  const unknown: string[] = [];
  const flags = parseArgs(cmd.args, { string: ['community', 'port', 'limit'], unknown: collectUnknownFlags(unknown) });
  if (await reportUnknownFlags(cmd, unknown)) return 1;
  const [host, root = SYSTEM] = flags._.map(String);
  if (!host) {
    await cmd.writeError('automation-snmp: usage: automation-snmp <host> [oid] [--community c] [--port n] [--limit n]\n');
    return 1;
  }
  try {
    await assertDevicesMember(cmd);
    const community = flags.community || (cmd.env.CFG_AUTOMATION_SNMP_COMMUNITY ?? '').trim() || DEFAULT_COMMUNITY;
    const walked = await snmpWalk({ host, community, ...(Number(flags.port) ? { port: Number(flags.port) } : {}) }, root.replace(/^\./, ''), Number(flags.limit) || 5000);
    const objects: SnmpObject[] = walked.map(({ oid, type, value }) => ({ oid, type, value: typeof value === 'bigint' ? String(value) : value }));
    if (cmd.json) await cmd.writeJSON(objects satisfies SnmpObject[]);
    else for (const each of objects) await cmd.writeLn(`${each.oid} = ${each.type}: ${each.value ?? ''}`);
    return 0;
  } catch (error) {
    await cmd.writeError(`automation-snmp: ${error instanceof Error ? error.message : error}\n`);
    return 1;
  }
};

automationSnmp.spec = {
  name: 'automation-snmp',
  effect: 'read' as const,
  description: "Walk a device's SNMP objects under an OID (the system group unless one is given), for members of the devices group",
  args: [
    { name: 'host', type: 'string' as const, description: 'its address' },
    { name: 'oid', type: 'string' as const, optional: true, description: 'where to walk from: 1.3.6.1.2.1.1 unless given' },
  ],
  flags: [
    { name: 'community', type: 'string' as const, description: 'the community to ask with, when not CFG_AUTOMATION_SNMP_COMMUNITY' },
    { name: 'port', type: 'string' as const, description: 'its agent’s port, when not 161' },
    { name: 'limit', type: 'string' as const, description: 'the most objects to answer (5000)' },
  ],
  examples: ['automation-snmp 192.0.2.40', 'automation-snmp 192.0.2.40 1.3.6.1.2.1.25.2.3', 'automation-snmp 192.0.2.40 1.3.6.1.4.1.4526 --community home'],
  returns: 'SnmpObject[]: oid, type, value',
};

export default automationSnmp;
